-- 1. ESP Trứng
b("ESP Trứng (Egg ESP)", 45, function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(obj.Name, "Egg") then
            if not obj:FindFirstChildOfClass("Highlight") then
                local h = Instance.new("Highlight", obj)
                h.FillColor = Color3.fromRGB(255, 165, 0)
            end
        end
    end
end)

-- 2. Teleport đến Trứng gần nhất
b("Teleport Trứng Gần Nhất", 82, function()
    local p = game.Players.LocalPlayer.Character
    if p and p:FindFirstChild("HumanoidRootPart") then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and string.find(obj.Name, "Egg") then
                local part = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    p.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                    break
                end
            end
        end
    end
end)

-- 3. Tự động tương tác/lượm trứng quanh người
b("Auto Farm / Nhặt Trứng Nhanh", 119, function()
    task.spawn(function()
        while task.wait(0.5) do
            local p = game.Players.LocalPlayer.Character
            if p and p:FindFirstChild("HumanoidRootPart") then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and string.find(obj.Name, "Egg") then
                        local part = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if part and (p.HumanoidRootPart.Position - part.Position).Magnitude < 15 then
                            firetouchinterest(p.HumanoidRootPart, part, 0)
                            firetouchinterest(p.HumanoidRootPart, part, 1)
                        end
                    end
                end
            end
        end
    end)
end)

