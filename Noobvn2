-- 7. Bay lượn map (Fly đơn giản)
b("Bật Chế Độ Bay (Fly)", 267, function()
    local p = game.Players.LocalPlayer
    local c = p.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        local bv = Instance.new("BodyVelocity", c.HumanoidRootPart)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        task.spawn(function()
            while c and c:FindFirstChild("HumanoidRootPart") do
                local cam = workspace.CurrentCamera.CoordinateFrame
                local move = Vector3.new(0,0,0)
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then move = move + cam.LookVector end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then move = move - cam.LookVector end
                bv.Velocity = move * 50
                task.wait()
            end
            bv:Destroy()
        end)
    end
end)

-- 8. Xuyên tường (NoClip)
b("Xuyên Tường (Noclip)", 304, function()
    game:GetService("RunService").Stepped:Connect(function()
        local c = game.Players.LocalPlayer.Character
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end)

